@using CanteenManage.Utility
@model CanteenManage.Models.FeedbackViewModel

@{
	Layout = "_LayoutCommitteeMember";
}

<div class="container-fluid">
	<div class="card">
		<div class="card-header">
			<h4>Feedbacks</h4>
		</div>
		<div class="card-body">
			<br />

			<!-- Page Size Selector -->
			<div class="row mb-3">
				<div class="col-md-3">
					<label for="pageSizeSelect" class="form-label">Items per page:</label>
					<select class="form-select" id="pageSizeSelect" onchange="changePageSize(this)">
						@{
							var pageSizes = new[] { 5, 10, 25, 50 };
							foreach (var size in pageSizes)
							{
								<option value="@size" selected="@(Model.PageSize == size)">@size</option>
							}
						}
					</select>
				</div>
			</div>

			<div class="table-responsive">
				<table class="table table-bordered table-striped table-hover">
					<thead>
						<tr>
							<th>Date</th>
							<th>Items</th>
							<th>Feedback</th>
							<th>EmployeeName</th>
							<th>Action Taken</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model.foodOrders)
						{
							<tr>
								<td>@item.RatingCreatedAt.ToString("dd-MM-yyyy")</td>
								<td>@item.Food?.Name</td>
								<td>@item.Review</td>
								<td>@item.Employee?.Name</td>
								<td>@item.ActionTaken</td>
							</tr>
						}
					</tbody>
				</table>
			</div>

			<!-- Pagination -->
			<div class="row">
				<div class="col-md-6">
					<p>Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) to @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems) of @Model.TotalItems entries</p>
				</div>
				<div class="col-md-6">
					<nav aria-label="Page navigation">
						<ul class="pagination justify-content-end">
							<li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
								<a class="page-link" href="@Url.Action("OrderFeedback", new { page = Model.CurrentPage - 1, pageSize = Model.PageSize })">Previous</a>
							</li>

							@for (int i = 1; i <= Model.TotalPages; i++)
							{
								<li class="page-item @(i == Model.CurrentPage ? "active" : "")">
									<a class="page-link" href="@Url.Action("OrderFeedback", new { page = i, pageSize = Model.PageSize })">@i</a>
								</li>
							}

							<li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
								<a class="page-link" href="@Url.Action("OrderFeedback", new { page = Model.CurrentPage + 1, pageSize = Model.PageSize })">Next</a>
							</li>
						</ul>
					</nav>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	.pagination .page-item.active .page-link {
		background-color: #0d6efd;
		border-color: #0d6efd;
	}

	.pagination .page-link {
		color: #0d6efd;
	}

	.pagination .page-item.disabled .page-link {
		color: #6c757d;
	}
</style>

<script>
	function changePageSize(select) {
		const pageSize = select.value;
		window.location.href = '@Url.Action("OrderFeedback")' + `?page=1&pageSize=${pageSize}`;
	}
</script>