@model CanteenManage.Models.FoodReportViewModel

@{
	ViewData["Title"] = "Orders for Date";
}

@{
	Layout = "_LayoutCommitteeMember";
}


<div class="container mt-5">
	<div class="card shadow-lg border-0 rounded-4">
		<div class="card-header bg-gradient text-black rounded-top-4">
			<h3 class="mb-0">Orders Details - @Model.ReportDate</h3>
		</div>
		<div class="card-body">
			@if (Model.FoodOrdersDetails != null && Model.FoodOrdersDetails.Any())
			{
				<table class="table table-hover table-bordered">
					<thead class="table-light">
						<tr>
							<th scope="col">#</th>
							<th scope="col">Employ Name</th>
							<th scope="col">Food Item</th>
							<th scope="col">Quantity</th>
							<th scope="col">Price</th>
							<th scope="col">EmployeePrice</th>
							<th scope="col">SubsidiaryPrice</th>
						</tr>
					</thead>
					<tbody>
						@for (int i = 0; i < Model.FoodOrdersDetails.Count; i++)
						{
							var order = Model.FoodOrdersDetails[i];
							<tr>
								<th scope="row">@(i + 1)</th>
								<td>@order.EmployeeName</td>
								<td>@order.FoodName</td>
								<td>@order.Quantity</td>
								<td>₹@order.TotalPrice.ToString("N2")</td>
								<td>₹@order.EmployeePrice.ToString("N2")</td>
								<td>₹@order.SubsidiaryPrice.ToString("N2")</td>
							</tr>
						}
					</tbody>
				</table>
			}
			else
			{
				<div class="alert alert-info">
					No orders found for the selected date.
				</div>
			}
		</div>
	</div>
</div>

