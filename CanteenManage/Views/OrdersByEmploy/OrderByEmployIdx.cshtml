						<div class="row row-cols-1">
							<div class="col">
								<div>Name:<span id="username" style="font-weight:500"></span></div>
							</div>

							<div class="col ">
								<div class="d-inline-flex gap-3">
									<div>Item:<span id="ordername" style="font-weight:500"></span></div>
									<div>Qnt.:<span id="orderqnt" style="font-weight:500"></span></div>
								</div>

							</div>
							<div class="col">
								<div>EmpId:<span id="orderid"></span></div>
							</div>
							<div class="col">
								<div>EmpId:<span id="userempid"></span></div>
							</div>
							<div class="col ">
								<button type="button" class="btn btn-primary align-self-end btn_conform_order_sr">Confirm</button>

							</div>
						</div>


					</div>
				</div>
			</div>
			<div class="d-flex flex-wrap" id="userordergrid">
			</div>
		</div>
	</div>
	<div class="card bg-white">
		<div class="card-header">
			<h6 class="card-title">@Model.screenTitle</h6>
		</div>

		<div class="card-body pt-2 pb-2">
			<form method="get" id="searchForm" class="row g-3 align-items-center">
				<input type="hidden" name="FoodType" value="@Model.FoodType" />

				<div class="col-auto">
					<input type="text" class="form-control searchinputs" name="searchTerm" id="searchinput" value="@Model.SearchValue" placeholder="Name or Id or Orderid" />
				</div>

				<div class="col-auto">
					<button type="button" id="searchbtn" class="btn btn-outline-primary d-flex align-items-center">
						<i class="bi bi-search me-2"></i> Search
					</button>
				</div>
			</form>
			@* <button type="button"  class="btn btn-outline-primary d-flex align-items-center">
				<i class="bi bi-search me-2"></i> Search
			</button> *@
		</div>
		<div class="row orderlistviewcontainer">
			<div class="d-flex justify-content-center mb-4 d-none">
				<div class="spinner-border" role="status">
					<span class="sr-only">Loading...</span>
				</div>
			</div>
			@(
						await Html.PartialAsync(CustomDataConstants.CustomViewPath + "\\_OrderListViewTodays", new OrderListViewTodaysDataModel()
			{
				EmployeeFoodOrdersTableData = Model.FoodOrders,
				FoodType = Model.FoodType,
			})
						)

		</div>


	</div>
</div>


@section Scripts {
	@* <script src="~/js/signalr.min.js"></script> *@

	@* <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script> *@

	@* 	<script src="https://npmcdn.com/@reactivex/rxjs@5.0.0-beta.3/dist/global/Rx.umd.js"></script> *@

	@* <script src="https://unpkg.com/rxjs@7/dist/bundles/rxjs.umd.min.js"></script> *@
	@* <script src="~/js/todays_order.js"></script> *@


	<script type="text/javascript">
		$(document).ready(function() {
			const foodtype=''+@(Model.FoodType)+'';
			const { range, filter, map,fromEvent,debounceTime,distinctUntilChanged,switchMap,catchError,from,of,Subject} = rxjs;
		const {fromFetch}=rxjs.fetch;
		const {ajax}=rxjs.ajax;
		let searchval="";
		const searchInputSubject = new Subject();

		searchInputSubject.pipe(
			debounceTime(300), // Wait for 300ms of inactivity before emitting
			distinctUntilChanged() // Only emit if the value has changed
		);
		const searchResultObs=searchInputSubject.pipe(
			map(value=>{
				console.log(value);
				$(".orderlistviewcontainer").html(`<div class="d-flex justify-content-center mb-4 ">
				<div class="spinner-border" role="status">
					<span class="sr-only">Loading...</span>
				</div>`);
				return value.trim();
			}),
			switchMap(searchValue =>
					{searchval=searchValue;
						return	fromFetch(`/OrderListView?FoodType=${foodtype}&searchTerm=${searchValue}`).pipe(
							switchMap(response => from(response.text())),
								   catchError(err => {
										console.error(err);
										return of("");
									})
				)}
		)
		);
		// Subscribe to the typeahead Observable
		const searchResultSubscriber=searchResultObs.subscribe(searchTerm => {
			$(".orderlistviewcontainer").html(searchTerm);
			//console.log(foodtype+'--Search term:', searchTerm);
		});
		//////////////////////////////////////////////////////////////
		const subjectConformBtn = new Subject();

		$('.orderlistviewcontainer').on('click', '.btn_order_complete', function(event) {
		  const button = event.currentTarget;
				const orderId = button.getAttribute('data-bs-FoodOrderId');
				const foodtypeId = button.getAttribute('data-bs-foodtype');
				//console.log(foodtypeId+"---"+orderId);
				const foodorderdtl = {
					foodorderid:orderId,foodtype:foodtypeId,searchval:$('#searchinput').val()
				}
				//console.log(foodorderdtl);
				subjectConformBtn.next(foodorderdtl);
		});

		const subjectconformclickObs=subjectConformBtn.pipe(
			debounceTime(300), // Wait for 300ms of inactivity before emitting
			distinctUntilChanged(), // Only emit if the value has changed
		);

		const conformResultObs=subjectconformclickObs.pipe(
			switchMap(data =>fromFetch(`/OrderListView/CompleteFoodOrder?foodorderid=${data.foodorderid}&foodtype=${data.foodtype}&searchTerm=${data.searchval}`).pipe(
					switchMap(response => from(response.text())),
					catchError(err => {
						console.error(err);
						return of("{}");
					})
				)
			)
		);

		const conformbtnsubscription=conformResultObs.subscribe(searchTerm => {
			$(".orderlistviewcontainer").html(searchTerm);
			//console.log(foodtype+'--Search term:', searchTerm);
		});
		/////////////////////////////////////////////////////////////////
		$('#searchinput').keyup(function() {
		  searchInputSubject.next($(this).val());
		});

		$('#searchbtn').click(function(){
			searchInputSubject.next($('#searchinput').val());
		});

		});
	</script>

}
