@section HeadSection
{
	<style>
		.customBage {
			background-color: #7e7e7ebf !important;
		}

		.scanBtn {
			color: #ff4249;
			border-color: #ff4249;
		}

			.scanBtn:hover {
				background-color: #ff4249;
				color: white;
				border-color: #ff4249;
			}

	</style>
	<style>
		/* Stack table rows on small screens */
		@@media (max-width: 767.98px) {
			.customTable thead {
				display: none;
			}

			.customTable tr {
				display: block;
				margin-bottom: 1rem;
				border: 1px solid #dee2e6;
				border-radius: 0.5rem;
				padding: 0.5rem;
				background-color: #f8f9fa;
			}

			.customTable td {
				display: flex;
				justify-content: space-between;
				padding: 0;
				padding-right: 2px;
				padding-left: 2px;
				border: none;
				border-bottom: 1px solid #dee2e6;
			}

				.customTable td:last-child {
					border-bottom: none;
				}

				.customTable td::before {
					content: attr(data-label);
					font-weight: bold;
					color: #6c757d;
				}

				.customTable td button {
					margin-top: 0.5rem;
				}
		}
	</style>
	<style>
		/* Mobile-first table styles */
		@@media (max-width: 767.98px) {
			tr .border-bottom {
				border: 1px solid #dee2e6;
				border-radius: 0.25rem;
				display: block;
				margin-bottom: 1rem;
				padding: 0.75rem;
			}

			td {
				display: flex;
				justify-content: space-between;
				padding: 0;
				border: none !important;
			}

				td:before {
					content: attr(data-label);
					font-weight: bold;
					margin-right: 1rem;
				}

				td[data-label]:before {
					content: attr(data-label) ":";
				}

			thead th {
				border: none !important;
			}
		}

		/* Desktop styles */
		@@media (min-width: 768px) {
			.table-responsive {
				overflow-x: auto;
			}

			tr.border-bottom {
				border-bottom: 1px solid #dee2e6;
			}
		}
	</style>

	<style>
		.customTable {
			border-collapse: collapse;
		}

			.customTable tr {
				border-bottom: 1px solid #dee2e6; /* Bootstrap's default border color */
			}

				.customTable tr:last-child {
					border-bottom: none; /* Remove border from last row */
					padding: 0;
				}
	</style>
}
<div class="container-fluid">
