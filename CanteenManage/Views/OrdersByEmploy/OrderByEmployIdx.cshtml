							</a>

							<a class="btn btn-outline-warning d-flex align-items-center px-2 py-1 shadow-sm"
							   asp-controller="OrdersByEmploy" asp-action="OrderByEmployIdx" asp-route-FoodType="3">
								<i class="bi bi-cup-straw me-2"></i> Snacks
							</a>
							<a class="btn btn-outline-primary d-flex align-items-center px-2 py-1 shadow-sm"
							   asp-controller="OrdersByEmploy" asp-action="OrderByEmployIdx" asp-route-FoodType="5">
