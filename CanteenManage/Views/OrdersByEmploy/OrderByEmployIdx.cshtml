		// ).subscribe(searchTerm => {
		// 	//$(".orderlistviewcontainer").html(searchTerm);
		// 	console.log(foodtype+'--Search term:', searchTerm);
		// });

		const conformResultObs=subjectconformclickObs.pipe(
			switchMap(data =>fromFetch(`/OrderListView/CompleteFoodOrder?foodorderid=${data.foodorderid}&foodtype=${data.foodtype}&searchTerm=${searchval}`).pipe(
					switchMap(response => from(response.text())),
					catchError(err => {
						console.error(err);
						return of("");
					})

				)
			)
		);
		// Subscribe to the typeahead Observable
		const conformbtnsubscription=conformResultObs.subscribe(searchTerm => {
			$(".orderlistviewcontainer").html(searchTerm);
			//console.log(foodtype+'--Search term:', searchTerm);
		});
		/////////////////////////////////////////////////////////////////
		const searchbtn=$("#searchbtn");
		const searchbtnobs=fromEvent(searchbtn, 'click').subscribe(event => console.log('Clicked'))



		});
	</script>
