@{
	Layout = "_Layout_canteenEmploy";
}
@section HeadSection
{
	<style>

		#html5-qrcode-button-camera-stop {
			visibility: hidden;
			display: none;
		}
	</style>

}
<div class="container-fluid">

	<div class="d-flex justify-content-center">
		<div class="card text-center">
			<div class="card-header">
				<div class="d-flex justify-content-between">
					<a class="" asp-controller="OrdersByEmploy" asp-action="OrderByEmployIdx" asp-route-FoodType="1">
						<i class="bi bi-arrow-left-circle-fill" style="font-size:20px"></i> Back
					</a>
					<h4>Scan Order</h4>
					<div>.</div>
				</div>

			</div>
			<div class="card-body flex-row">
				<div class="" style="min-width:350px">
					<div class="position-relative d-none" id="qr-container">
						<div id="qr-reader" class="rounded-2" style=""></div>
						@* <div class="position-absolute bottom-0 end-0 bg-white w-100" style="height:45px;"></div> *@
					</div>
				</div>
				<div id="qr-reader-results"></div>
				<br />
				<div class="d-inline-flex gap-2">
					<button class="btn btn-success" id="scanqr">Scan</button>

					<button class="btn btn-danger" id="stopqr">Stop</button>
				</div>
				<div class="d-flex justify-content-center mt-2 d-none" id="detailsLoader">

					<div class="spinner-border text-warning" role="status">
						<span class="sr-only">Loading...</span>
					</div>
				</div>
				<div class="card mt-2 d-none" id="ord_Details_Container">
					<div class="card-body">
						@* <div class="spinner-border text-info" role="status">
							<span class="visually-hidden">Loading...</span>
						</div> *@

						<div>
							<div class="d-flex">Name:<strong><span id="oname"></span></strong></div>
							<div class="d-flex">EmpId:<span id="oempid"></span></div>
							<div class="d-flex">Item:<strong><span id="oitem"></span></strong></div>
							<div class="d-flex">OrderId:<span id="oorderid"></span></div>
							<div class="d-flex">Quantity:<strong><span id="oquantity"></span></strong></div>
							<div class="d-flex">Date:<span id="odate"></span></div>
							<div class="d-flex">Status:<strong><span id="ostatus"></span></strong></div>
							<button class="btn btn-primary" id="btn_conform">
								<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="display: none;"></span>
								<span class="button-text">Conform</span>
							</button>
						</div>
					</div>
				</div>

			</div>
		</div>
	</div>
	<input type="hidden" id="scanedid" value="" />
</div>

@section Scripts {

	<script src="~/js/html5-qrcode.min.js"></script>

	<script type="text/javascript">
		$(function(){

		async function checkCameraPermission() {
		  try {
			const stream = await navigator.mediaDevices.getUserMedia({ video: true });
			stream.getTracks().forEach(track => track.stop());
			return true;
		  } catch (error) {

			console.error("Error accessing camera:", error);
			return false;

		  }
		}

		const { range, filter, map,fromEvent,debounceTime,distinctUntilChanged,switchMap,catchError,from,of,Subject} = rxjs;
		const {fromFetch}=rxjs.fetch;
		const {ajax}=rxjs.ajax;

			var resultContainer = document.getElementById('qr-reader-results');

			const formatsToSupport = [
			Html5QrcodeSupportedFormats.QR_CODE
			];
			const subjectOrderDetails = new Subject();
			const subjectOrderConform = new Subject();

			var html5QrcodeScanner = new Html5QrcodeScanner("qr-reader", { fps: 10, qrbox: 200
				,supportedScanTypes: [Html5QrcodeScanType.SCAN_TYPE_CAMERA],
				 showTorchButtonIfSupported:true,
				 formatsToSupport: formatsToSupport
			});
			function onScanSuccess(decodedText, decodedResult) {

			//console.log(`Scan result: ${decodedText}`, decodedResult);
			html5QrcodeScanner.clear();
			clearAllDetails();
			$("#qr-container").addClass("d-none");
			$('#scanedid').val(decodedText);
			 const orderdetl={
			orderdetails:decodedText
			};
			subjectOrderDetails.next(orderdetl);
			$("#ord_Details_Container").addClass("d-none");
			}

			function onScanError(errorMessage) {
				// handle on error condition, with error message
				//console.log(errorMessage);
			}

			$('#scanqr').click(function() {

				clearAllDetails();
			$('#ord_Details_Container').addClass("d-none");
			checkCameraPermission().then(hasPermission => {
			  if (hasPermission) {
				// Proceed with camera-related functionality
				$("#qr-container").removeClass("d-none");
				html5QrcodeScanner.render(onScanSuccess,onScanError);
			  } else {
				// Handle the case where permission is not granted
				alert("Camera permission is required to scan QR codes. Please allow camera access in your browser settings.");
			  }
			});

			// $('#scanedid').val("encodeorder");
			//$('#scanedid').val("tlis+77y9vs5fcWSAOEqDrH6U9IeOQ6Lqxbc83ACsGj5pldj6WV2ckK1VpS5SRys");
			// const roderdetl={
			// orderdetails:'tlis+77y9vs5fcWSAOEqDrH6U9IeOQ6Lqxbc83ACsGj5pldj6WV2ckK1VpS5SRys'
			// };
			// subjectOrderDetails.next(roderdetl);
			// $("#ord_Details_Container").addClass("d-none");
			});

			$('#stopqr').click(function() {
					html5QrcodeScanner.clear();
					clearAllDetails();
							$("#qr-container").addClass("d-none");
							$("#ord_Details_Container").addClass("d-none");
			});

			$('#btn_conform').click(function() {
			const orderdetl={
			orderdetails:$('#scanedid').val()
			};
			subjectOrderConform.next(orderdetl);
			//console.log($('#scanedid').val());
			});
			const subjectOrderDetailsPipe=subjectOrderDetails.pipe(
			map(val => {
				$('#detailsLoader').removeClass("d-none");
				$('#ord_Details_Container').addClass("d-none");
				return val;
			}),
			debounceTime(300), // Wait for 300ms of inactivity before emitting
			//distinctUntilChanged(), // Only emit if the value has changed
			);

			const subjectOrderDetailsPipe2=subjectOrderDetailsPipe.pipe(
						switchMap(data =>{

							return fromFetch(`/OrdersByEmploy/SingleOrderDetailP`, {
		  method: 'POST',
		  headers: {
			'Content-Type': 'application/json'
		  },
		  body: JSON.stringify(data) // Convert the data to a JSON string
		}
				).pipe(
					switchMap(response => from(response.json())),
					catchError(err => {
						console.error(err);
						return of("");
					})
				)}
			)
			);
		  const subjectOrderdetailssubscrib=subjectOrderDetailsPipe2.subscribe((orderData) => {
				// Process the order details here

				var errormessage=orderData.error??"";
				$('#detailsLoader').addClass("d-none");

				if(errormessage === "")
				{
				$('#oname').html(orderData.detail.employeeName);
				$('#oempid').html(orderData.detail.employeeCode);
				$('#oorderid').html(orderData.detail.foodOrderId);
				$('#oquantity').html(orderData.detail.quantity);
				if(orderData.detail.isCompleted==true)
				{
					$('#ostatus').html(`<span class="badge bg-success rounded-pill px-3 py-2 shadow-sm d-inline-flex align-items-center">
										<i class="bi bi-check-circle"></i></span>`);
					$("#btn_conform").addClass("d-none");
				}else{
					$('#ostatus').html(`<span class="badge bg-warning text-dark rounded-pill px-3 py-2 shadow-sm d-inline-flex align-items-center">
														<i class="bi bi-hourglass-split"></i>
													</span>`);
					$("#btn_conform").removeClass("d-none");
				}

				$('#oitem').html(orderData.detail.foodName);//
				$('#odate').html(orderData.detail.orderDateS);
				$("#ord_Details_Container").removeClass("d-none");

				}
				else{
					$("#ord_Details_Container").addClass("d-none");
					showErrorMessage(errormessage);
				}

			});
			////////////////////////////////////////////////////////////////
			const subjectOrderConformPipe=subjectOrderConform.pipe(
			debounceTime(300), // Wait for 300ms of inactivity before emitting
			);
			////=${data}
			const subjectOrderConformPipe2=subjectOrderConformPipe.pipe(
				map(data=>{
					var $button = $('#btn_conform');
			var $spinner = $button.find('.spinner-border');
			var $buttonText = $button.find('.button-text');

			// Show spinner and hide text
			$spinner.show();
			//$buttonText.hide();
			$button.prop('disabled', true); // Disable the button

				return data;
				}),
						switchMap(data =>fromFetch(`/OrdersByEmploy/SingleOrderConform`, {
						  method: 'POST',
						  headers: {
							'Content-Type': 'application/json',
						  },
						  body: JSON.stringify(data)
						}
						).pipe(
					switchMap(response => from(response.json())),
					catchError(err => {
						console.error(err);
						return of("{}");
					})
				)
			)
			);
		  const subjectOrderConformsubscrib=subjectOrderConformPipe2.subscribe((orderDetails) => {

				var $button = $('#btn_conform');
				var $spinner = $button.find('.spinner-border');
				var $buttonText = $button.find('.button-text');

				// Show spinner and hide text
				$spinner.hide();
				//$buttonText.hide();
				$button.prop('disabled', false); // Disable the button

				if(orderDetails.error==='')
				{
				showInfoMessage("Item Conformed!!!!");
				// $("#ord_Details_Container").addClass("d-none");
				$('#ostatus').html(`<span class="badge bg-success rounded-pill px-3 py-2 shadow-sm d-inline-flex align-items-center">
										<i class="bi bi-check-circle"></i></span>`);

				}
				else{
					showErrorMessage(orderDetails.error);
				}
			});
		function clearAllDetails()
		{
			$('#oname').html("");
			$('#oempid').html("");
			$('#oorderid').html("");
			$('#oquantity').html("");
			$('#ostatus').html("");
			$('#oitem').html('');odate
			$('#odate').html('');
		}
		}
		);

	</script>
}



