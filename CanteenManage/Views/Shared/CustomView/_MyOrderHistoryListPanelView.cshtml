@using CanteenManage.Utility
@model CanteenManage.Models.MyOrderListPanelViewModel

<div class="col @(Model.FoodOrders.Count()<=0?"d-none":"") " style="padding-left:2px;padding-right:2px">
	<div class="card customCard mt-2">
		<div class="cardTitle fw-bold">
			@Model.PanelTitle
		</div>
		<div class="card-body custom_card_body">
			<div class="table-responsive">
				<table class="table table-hover table-responsive-sm table-borderless customTable">
					<thead>
						<tr>
							<th>Date</th>
							<th>OrdNo.</th>
							<th>Name</th>
							<th></th>
							<th></th>
							<th></th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						@foreach (var order in Model.FoodOrders)
						{
							<tr>
								<td>@order.OrderDateCustom.ToString("dd-MMM-")@order.OrderDateCustom.ToString("ddd")</td>
								<td>@order.OrderID</td>

								<td class="customTableBoldCell" colspan="4">
									<table class="table table-borderless">
										<tr>
											<td colspan="4">@order.FoodName</td>
										</tr>
										<tr>
											<td><span style="font-weight:400">Qnt:</span> @order.Quantity.ToString()</td>
											<td class="" style="text-align:end">&#8377;@order.TotalEmployeePrice.ToString()</td>
											<td class="align-self-center text-center myOrderStatusPanel" data-orderid="@order.OrderID">
											<td>
													@if (!@order.IsCompleted)
													{
													<span class="badge rounded-pill bg-warning text-dark">
														<i class="fas fa-hourglass-half me-1"></i>
													</span>
													}
													else
													{
													<span class="badge rounded-pill bg-success">
														<i class="bi bi-check-circle-fill text-white me-1"></i>
													</span>
													}
											</td>
											<td class="align-self-center text-center" style="vertical-align:middle;">
													@if (!order.IsCompleted)
													{

													}
													else
													{
														@if (order.Rating == null)
														{
														<a href="javascript:void(0);"
														   data-bs-toggle="modal"
														   data-bs-target="#exampleModal"
														   data-bs-orderid="@order.OrderID"
														   title="Add Review">
															<i class="bi bi-chat-left-text-fill fs-5 text-primary"></i>
														</a>
														}
														else
														{
														<a href="javascript:void(0);" data-bs-toggle="modal"
														   data-bs-target="#viewReviewModal"
														   title="View Review"
														   data-bs-rating="@order.Rating"
														   data-bs-review="@order.Review">
															<i class="bi bi-eye-fill fs-5 text-success"></i>
														</a>

														}
													}
											</td>
										</tr>
									</table>
								</td>

							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>
