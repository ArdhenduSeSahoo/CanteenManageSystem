@model CanteenManage.Models.parcialViewModel.FoodItemCardDataModel;
@using System.Globalization;

@{
	var food = Model.Food;
}

<div class="card h-100 bg-white cardCustom" style=" border-radius:10px">
	<div class="" style="">
		<div class="itemImageDiv" style=" border-radius:10px;padding:2px">
			<img src="~/FoodImage/@(food.ImageUrl)" class="card-img-top img-fluid rounded mx-auto d-block w-100" style="height: 200px;" alt="...">
		</div>
	</div>
	<div class="card-body pt-2 pb-0">
		<div class="d-flex justify-content-between">
			<div class="d-flex flex-column">
				<h5 class="card-title text-wrap" style="font-size: 17px;">
					@CultureInfo.InvariantCulture.TextInfo.ToTitleCase(food.Name)
				</h5>
				@if (food.Rating > 0)
				{
					<div class="d-flex">
						<div class="d-inline-flex">
							@foreach (int index in Enumerable.Range(1, Convert.ToInt32(food.Rating)))
							{
								<div class="d-flex">
									<img src="~/images/emoji/starRating.png" class=" star_design align-self-center" alt="rating" style="">
								</div>
							}
							@if (food.UserRateGiven != null)
							{
								<div class="d-flex">
									<span class="" style="color:gray;margin-left:4px">(@food.UserRateGiven)</span>
								</div>
							}
						</div>
					</div>
				}
			</div>

			<div class="d-flex flex-column align-content-end">

				<h6 class="text-danger fw-bold text-end">₹@food.EmployeePrice.ToString("0.00")</h6>
				@if (food.IsVegFood != null)
				{
					<div class="mb-2 align-self-end">
						@if (food.IsVegFood ?? false)
						{
							<img src="~/images//VegFoodIcon.png" class=" star_design" alt="rating" style="height: 25px;width: 25px;">
						}
						else
						{
							<img src="~/images//NonVegFoodIcon.png" class="star_design" alt="rating" style="height: 25px;width: 25px;">
						}
					</div>
				}

			</div>

		</div>
		<p class="card-subtitle mb-2 text-muted" style="font-size:12px">@(food.Description == "" ? "." : food.Description)</p>
	</div>
	<div class="card-footer text-muted border-0 bg-white rounded-2 pt-0">
		@if (Model.ShowAddToCartButton)
		{
			<div class="d-flex justify-content-between">
				<div></div>
				<div>
					<div class="row align-self-end">

						<div class="col align-self-end food_add_btn_div @(food.EmployeeCarts.Count()<=0?"":"d-none")" data-foodid="@food.Id">
							<button class="btn addBtn btn_addItem" data-foodid="@food.Id" type="button">Add</button>
						</div>
						<div class="col align-self-end food_add_remove_btn_div @(food.EmployeeCarts.Count()>0?"":"d-none")" data-foodid="@food.Id">
							<div class="btn-group" role="group" aria-label="">
								<button type="button" style="border-radius:0px;border-bottom-left-radius:7px;border-top-left-radius:7px;" class="btn btn-outline-info btn_removeItem" data-foodid="@food.Id">
									<i class="fa-solid fa-minus " style=""></i>
								</button>
								<div class="btn btn-outline-info btn_food_quantity" data-foodid="@food.Id" style=" border-radius:0px; color:black">@food.EmployeeCarts?.FirstOrDefault()?.Quantity</div>
								<button type="button" class="btn btn-outline-info btn_addItem" data-foodid="@food.Id" style="border-radius:0px;border-bottom-right-radius:7px;border-top-right-radius:7px;"><i class="fa-solid fa-plus"></i></button>
							</div>
						</div>

					</div>
				</div>
			</div>
		}
	</div>
</div>



