@using CanteenManage.Utility
@model CanteenManage.Models.CanteenOrderReportViewDataModel

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
	Layout = "_Layout_canteenEmploy";
}


<div class="container-fluid">
	<div class="card">

		<div class="card-header">
			<h5 class="">Order Report</h5><span>(Subsidiary)</span>
		</div>
		<div class="card-body">
			<div class="container-fluid">
				<div class="">
					<div class="">
						<form class="row g-2" asp-action="CanteenOrderReport" method="get">

							<div class="col-md-2">
								<label for="inputZip" class="form-label">From</label>
								<input type="text" id="fromDatePicker" name="fromDatePicker" placeholder="Select From Date" class="form-control form-control-solid flatpickr-input">
							</div>
							<div class="col-md-2">
								<label for="inputZip" class="form-label">To</label>
								<input type="text" id="toDatePicker" name="toDatePicker" placeholder="Select To Date" class="form-control form-control-solid flatpickr-input">
							</div>
							<div class="col-12">
								<div class="form-check form-check-inline">
									<input class="form-check-input" type="radio" name="orderStatusOptions" id="inlineRadio1" value="1" @(Model.orderStatusOptions == "1" ? "checked" : null)>
									<label class="form-check-label" for="inlineRadio1">Completed</label>
								</div>
								<div class="form-check form-check-inline">
									<input class="form-check-input" type="radio" name="orderStatusOptions" id="inlineRadio2" value="2" @(Model.orderStatusOptions == "2" ? "checked" : null)>
									<label class="form-check-label" for="inlineRadio2">UnCompleted</label>
								</div>
								<div class="form-check form-check-inline">
									<input class="form-check-input" type="radio" name="orderStatusOptions" id="inlineRadio3" value="3" @(Model.orderStatusOptions == "3" ? "checked" : null)>
									<label class="form-check-label" for="inlineRadio3">All</label>
								</div>
							</div>
							<div class="col-12">
								<button type="submit" class="btn btn-primary">Search</button>
							</div>
						</form>

					</div>
					<div class="col-1">
					</div>
				</div>

			</div>
		</div>
	</div>

	<div class="card">
		<div class="card-body">
			<form method="post" action="ExportToExcel">
				<input type="hidden" name="fromDatePicker" value="@Model.fromDatePicker" />
				<input type="hidden" name="toDatePicker" value="@Model.toDatePicker" />
				<input type="hidden" name="orderStatusOptions" value="@Model.orderStatusOptions" />
				<button type="submit" class="btn btn-primary">Download Excel</button>
			</form>
			<br />
			<div class="table-responsive">
				<table class="table table-bordered table-striped table-hover">
					<thead class="table-primary">
						<tr>

							<th>Order Date</th>
							<th>Order Count</th>
							<th>Employee Count</th>
							<th>TotalQuantity</th>
							<th>TotalPrice</th>
							<th>TotalEmployeePrice</th>
							<th>TotalSubsidyPrice</th>
							<th>Action</th>

						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model.canteenOrdersReportTableViewDataModels.Take(Model.canteenOrdersReportTableViewDataModels.Count() - 1))
						{
							<tr>
								<td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
								<td>@item.TotalOrderCount</td>
								<td>@item.TotalEmployeeCount</td>
								<td>@item.TotalQuantity</td>
								<td>@item.TotalPrice</td>
								<td>@item.TotalEmployeePrice</td>
								<td>@item.TotalSubsidyPrice</td>
								<td>
									<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#orderDetailsModal" data-orderDate="@item.OrderDate.ToString("yyyy-MM-dd")" data-orderStatusOptions="@Model.orderStatusOptions" data-IsNonSubsidiary="true">
										<i class="fa fa-eye"></i>
									</button>
									@* <a asp-action="OrderReportDetails" asp-controller="CanteenOrderReport"
									   asp-route-orderDate="@item.OrderDate.ToString("yyyy-MM-dd")" asp-route-orderStatusOptions="@Model.orderStatusOptions" target="_blank"
									   class="btn btn-primary">
										<i class="fa fa-eye"></i>
									</a> *@
								</td>
							</tr>
						}

					</tbody>
					<tfoot>
						<tr>
							<td style="font-weight:600">Total</td>
							<td style="font-weight:600">@(Model.canteenOrdersReportTableViewDataModels.LastOrDefault().TotalOrderCount)</td>
							<td style="font-weight:600">
								@(Model.canteenOrdersReportTableViewDataModels.LastOrDefault().TotalEmployeeCount)
							</td>
							<td style="font-weight:600">@(Model.canteenOrdersReportTableViewDataModels.LastOrDefault().TotalQuantity)</td>
							<td style="font-weight:600">@(Model.canteenOrdersReportTableViewDataModels.LastOrDefault().TotalPrice)</td>
							<td style="font-weight:600">@(Model.canteenOrdersReportTableViewDataModels.LastOrDefault().TotalEmployeePrice)</td>
							<td style="font-weight:600">@(Model.canteenOrdersReportTableViewDataModels.LastOrDefault().TotalSubsidyPrice)</td>
						</tr>
					</tfoot>
				</table>
			</div>
		</div>
	</div>
</div>
<!-- Modal -->
<div class="modal fade" id="orderDetailsModal" tabindex="-1" aria-labelledby="orderDetailsModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h1 class="modal-title fs-5" id="orderDetailsModalLabel">Order Details-<span id="datefor"></span></h1>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<table id="dataTable_modal" class="table table-hover table-bordered">
					<thead class="table-primary">
						<tr>
							<th scope="col">#</th>
							<th scope="col">Employ Name</th>
							<th scope="col">Item</th>
							<th scope="col">Type</th>
							<th scope="col">Qnt.</th>
							<th scope="col">Price</th>
							<th scope="col">Emp. Price</th>
							<th scope="col">Subsidiary Price</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>..</td>
							<td>..</td>
							<td>..</td>
							<td>..</td>
							<td>
								<div class="spinner-border text-warning" role="status">
									<span class="visually-hidden">Loading...</span>
								</div>
							</td>
							<td>..</td>
							<td>..</td>
							<td>..</td>
						</tr>
					</tbody>
				</table>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

			</div>
		</div>
	</div>
</div>

@section Scripts {

	<script>

		$(document).ready(function () {


		$("#fromDatePicker").flatpickr({

		enableTime: false,
		disableMobile: true,
		altInput: true,
		mode: "single",
		altFormat: "m-d-Y",
		dateFormat: "m-d-Y",
		defaultDate: ["@Model.fromDatePicker"],
		onChange: function(selectedDates, dateStr, instance) {
		console.log(selectedDates);
		},
		});
		$("#toDatePicker").flatpickr({

		enableTime: false,
		disableMobile: true,
		altInput: true,
		mode: "single",
		altFormat: "m-d-Y",
		dateFormat: "m-d-Y",
		defaultDate: ["@Model.toDatePicker"],
		onChange: function(selectedDates, dateStr, instance) {
		console.log(selectedDates);
		},
		});

		$('#orderDetailsModal').on('shown.bs.modal', function (e) {
			var foodid = $(e.currentTarget).data("foodid");
				//console.log("Add Item button clicked---"+foodid);

				var button = e.relatedTarget;
				var orderDate = button.getAttribute('data-orderDate');
				var orderStatusOptions = button.getAttribute('data-orderStatusOptions');
				var dataTable=$( "#orderDetailsModal").find('#dataTable_modal');
				var dataTableBody=dataTable.find('tbody');
				dataTableBody.empty();
						dataTableBody.append(`<tr><td>..</td><td>..</td><td>..</td><td>..</td><td><div class="spinner-border text-warning" role="status">
		  <span class="visually-hidden">Loading...</span>
		</div></td><td>..</td>
							<td>..</td>
							<td>..</td>
						</tr>`);
				try {
					var getUrl="/CanteenOrderReport/OrderReportDetailsApi?orderDate="+orderDate+"&orderStatusOptions="+orderStatusOptions+"&IsNonSubsidiary=false";
					// Send the GET request using fetch
					fetch(getUrl, {
						method: "GET",
						headers: {
							"Content-Type": "application/json"
						}
					})
						.then((response) => response.json())
						.then((data) => {
							//debugger;
							data=JSON.parse(data);
							console.log("Success:", data);
							$( "#orderDetailsModal").find('#datefor').html(data.ReportDate);
							dataTableBody.empty();
							data.FoodOrdersDetails.forEach(function(item,index) {
								const newRowHtml = "<tr><td>"+(index+1)+"</td><td>"+item.EmployeeName+"</td><td>"+item.FoodName+"</td><td>"+item.FoodTypeName+"</td><td>"+item.Quantity+"</td><td>"+item.TotalPrice+"</td><td>"+item.EmployeePrice+"</td><td>"+item.SubsidiaryPrice+"</td></tr>";

								dataTableBody.append(newRowHtml);
									});
							//

						})
						.catch((error) => console.error("Error:", error));

				}
				catch (error) {
					console.log(error);
				}
		});
		$('#orderDetailsModal').on('hidden.bs.modal', function (e) {

			var dataTable=$( "#orderDetailsModal").find('#dataTable_modal');
				var dataTableBody=dataTable.find('tbody');
				dataTableBody.empty();
						dataTableBody.append(`<tr><td>..</td><td>..</td><td>..</td><td>..</td><td><div class="spinner-border text-warning" role="status">
		  <span class="visually-hidden">Loading...</span>
		</div></td><td>..</td>
							<td>..</td>
							<td>..</td>
						</tr>`);
			$( "#orderDetailsModal").find('#datefor').html("---");
		});


		});
	</script>
}

