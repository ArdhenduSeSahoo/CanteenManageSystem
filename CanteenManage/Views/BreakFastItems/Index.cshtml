@using CanteenManage.CanteenRepository.Models
@using CanteenManage.Models
@using CanteenManage.Models.parcialViewModel
@model BreakFastPageDataModel;


@section HeadSection {

	<link rel="stylesheet" href="~/css/customStyles.css">
	<style>
		.datepicker_custom {
			z-index: 1;
			opacity: 0 !important;
		}
	</style>
}

<div class=" container-fluid" style="
">
	<div class="card mb-1" style="border-radius:15px">
		<div class="card-body">
			<div class="d-flex justify-content-between">
				<div class="row">
					<div class="col">
						<h3>Breakfast Items</h3>
					</div>
				</div>
			</div>

			<div class="date-selector">
				<label class="date-label">Choose Date:</label>
				<div class="date-buttons">
					@foreach (var dayes in Model.DayOfWeeks)
					{

						@(
													await Html.PartialAsync("_ChoseDateVew", new ChoseDateViewDataModel()
					{
						daysOfWeekModel = dayes,
					})
													)
					}

				</div>
			</div>

			@* 	<div class="d-flex " style="width:250px; position:relative;">
				<input type="text" id="myDatePicker" value="" placeholder="Select Date" class="form-control form-control-solid flatpickr-input datepicker_custom z-1">
				<img src="~/images/datePicker.png" alt="Calendar Icon" class="calendar-icon z-0" style="width: 35px; height: 35px; cursor: pointer; position:absolute;z-index:0;">
			</div> *@

			<div class="d-flex ">
				<div class="row">
					<div class="col">
						<p>Total on @(Model.DayOfWeeks.Where(d => d.IsSelected)?.FirstOrDefault()?.DateTime.ToString("dd-MMM")): <b><span class="food_total_quantity"> @(Model.totalCountForSelectedDay)</span></b></p>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row row-cols-1 row-cols-md-5 g-2">
		@foreach (FoodDetails food in Model.foods)
		{
			<div class="col">
				@(
							await Html.PartialAsync("_FoodItemCardView", new FoodItemCardDataModel()
			{
				Food = food,
				ShowAddToCartButton = true,
			})
							)
			</div>
		}

	</div>
</div>



@section Scripts {
	<script src="~/js/canteensystem_js.js"></script>
	<script>

			$(document).ready(function () {

			$(".btn_addItem").click( async function (e) {

				addFoodItem(e,"/api/FoodOrders/breakfastFoodOrderAdd");

			});
			$(".btn_removeItem").click( async function (e) {
				removeFoodItem(e,"/api/FoodOrders/OrderRemove");

			});

